AICALENDAR_DB=/opt/aicalendar/data/aicalendar.sqlite
AICALENDAR_LISTEN=127.0.0.1:18086
AICALENDAR_BASE_PATH=/aicalendar/
AICALENDAR_ORIGIN=https://YOUR_SERVER
# During migration: HTTPS ALI address, VPS address with :8443, and NAS LAN address.
# AICALENDAR_ALLOWED_ORIGINS=https://VPS_PUBLIC_IP:8443,https://NAS_LAN_IP
AICALENDAR_TOKEN_HASH_FILE=/opt/aicalendar/config/import-token.sha256
