    "/api/v1/export": {
      "get": {
        "summary": "Export records and annotations",
        "responses": {
          "200": {
            "description": "JSON export"
          }
        }
      }
    },
    "/api/v1/activities/{id}/annotation": {
      "patch": {
        "summary": "Replace user annotation with optimistic version check",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "expected_version": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "annotation": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "title": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "summary": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "tags": {
                        "anyOf": [
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "hidden": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "hidden"
                    ]
                  }
                },
                "required": [
                  "expected_version",
                  "annotation"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated activity"
          },
          "409": {
            "description": "Version conflict"
          }
        }
      }
    }
