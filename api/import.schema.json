{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Crashmere/AICalendar/blob/main/api/import.schema.json",
  "title": "AICalendar import v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "mode": {
      "type": "string",
      "enum": [
        "insert_only",
        "upsert"
      ]
    },
    "records": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
          },
          "external_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 300
          },
          "activity_date": {
            "type": "string",
            "format": "date"
          },
          "timezone": {
            "type": "string",
            "minLength": 1
          },
          "first_activity_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_activity_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "user_message_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          },
          "tags": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "spans": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "start",
                "end"
              ]
            }
          },
          "quality": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "string",
                "enum": [
                  "observed",
                  "estimated",
                  "unknown"
                ]
              },
              "time": {
                "type": "string",
                "enum": [
                  "observed_interval",
                  "observed_timestamps",
                  "estimated_interaction_span",
                  "date_only",
                  "unknown"
                ]
              },
              "topic": {
                "type": "string",
                "enum": [
                  "source_title",
                  "agent_summary",
                  "manual"
                ]
              }
            },
            "required": [
              "count",
              "time",
              "topic"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "producer": {
                "type": "string",
                "maxLength": 160
              },
              "source_ref": {
                "type": "string",
                "maxLength": 300
              },
              "produced_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "method"
            ]
          },
          "record_state": {
            "type": "string",
            "enum": [
              "partial",
              "final"
            ]
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "source_label": {
            "type": "string",
            "maxLength": 80,
            "description": "User supplied display label; distinct from the stable source key"
          }
        },
        "required": [
          "source",
          "external_id",
          "activity_date",
          "timezone",
          "first_activity_at",
          "last_activity_at",
          "user_message_count",
          "title",
          "summary",
          "tags",
          "spans",
          "quality",
          "provenance",
          "record_state"
        ]
      }
    },
    "coverage": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unknown"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "source",
          "from",
          "to",
          "status"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "idempotency_key",
    "mode",
    "records"
  ]
}
